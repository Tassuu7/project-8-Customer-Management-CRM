# Application Environment Configuration
NODE_ENV=development
PORT=5080
HOST=0.0.0.0
APP_NAME=OmniCustomer-360-CRM
APP_URL=http://localhost:5080

# Security & Authentication
JWT_SECRET=super-secret-enterprise-jwt-key-replace-in-production-vault
JWT_EXPIRATION=86400
REFRESH_TOKEN_EXPIRATION=604800
BCRYPT_ROUNDS=10

# Database Configuration
DB_STORAGE_TYPE=file
DB_STORAGE_PATH=./data/crm_storage.json
DB_AUTO_SAVE_INTERVAL_MS=3000

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000

# Logging
LOG_LEVEL=debug
LOG_FILE_PATH=./logs/app.log
LOG_ENABLE_CONSOLE=true
LOG_ENABLE_AUDIT_STREAM=true
